# Backend Port (Render sets this dynamically)
PORT=5000

# MongoDB Connection String (e.g. from MongoDB Atlas Free Cluster M0)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/crowdfunding?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/crowdfunding

# Razorpay API Credentials (from https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_HERE
RAZORPAY_KEY_SECRET=YOUR_SECRET_KEY_HERE

# Frontend Deployed URL (for CORS allowance)
FRONTEND_URL=http://localhost:5173
