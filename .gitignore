# Dependencies
node_modules/
backend/node_modules/
crowd-funding-app/node_modules/
*/node_modules/

# Production build outputs
dist/
dist-ssr/
crowd-funding-app/dist/
build/

# Environment and sensitive credentials
.env
.env.*
backend/.env
backend/.env.*
crowd-funding-app/.env
crowd-funding-app/.env.*

# Allow example environment files
!.env.example
!backend/.env.example
!crowd-funding-app/.env.example

# Runtime generated Excel spreadsheets (prevent binary commit bloat)
data/*.xlsx
!data/.gitkeep

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor & OS files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
